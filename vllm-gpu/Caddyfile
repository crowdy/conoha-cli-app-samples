{$DOMAIN_NAME} {
    reverse_proxy vllm:8000 {
        # Streaming/SSE support for /v1/chat/completions stream=true
        flush_interval -1
    }
    @not_sse {
        not header Content-Type text/event-stream
    }
    encode @not_sse gzip
    log {
        output stdout
        format json
    }
}

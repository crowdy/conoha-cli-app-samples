# OpenAI Realtime API
OPENAI_API_KEY=sk-...
OPENAI_REALTIME_MODEL=gpt-realtime-2

# Google Sheets — paste the FULL service-account JSON on one line
# (the example below shows the keys you should expect; replace the values)
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"sheets-writer@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/sheets-writer%40your-project.iam.gserviceaccount.com"}
SHEET_ID=your-google-sheet-id

# Shown in the AI greeting
RESTAURANT_NAME=カフェ・コノハ

# SECURITY (recommended for any public deploy)
# Comma-separated origins allowed to call /api/*. Empty = allow all (dev only).
ALLOWED_ORIGINS=https://voice-agent.example.com
# Per-IP cap on ephemeral-token minting (each minted token consumes OpenAI quota).
SESSION_RATE_LIMIT_PER_MIN=6

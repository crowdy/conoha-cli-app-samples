# Copy to .env and adjust. Never commit .env (see .gitignore / CONTRIBUTING.md).

# --- ConoHa server ---
SERVER_NAME=vcluster-host
# Flavor names vary by region/time. 4 vCPU / 4GB is comfortable for k3s + 2 vclusters.
# A ~2GB option is g2l-t-c3m2. Confirm available names with: conoha flavor list
FLAVOR=g2l-t-c4m4
# Image name or ID. A plain Ubuntu base is required (not an app image).
# A plain ubuntu-24.04 base may be unavailable; pick one from: conoha image list
# (the reference e2e used ubuntu-26.04). You may pass either a name or an image ID.
IMAGE=ubuntu-24.04
KEY_NAME=mykey          # name of an SSH keypair registered in ConoHa (conoha keypair list)
# Space-separated security group names. SSH (22) must be open for `conoha server ssh`.
# Confirm names with: conoha network security-group list
SECURITY_GROUPS=default IPv4v6-SSH

# --- Versions (pinned for reproducibility; override if you like) ---
K3S_VERSION=v1.31.5+k3s1
VCLUSTER_VERSION=v0.24.1

# --- Virtual cluster namespaces on the host ---
TENANT_A_NS=team-a
TENANT_B_NS=team-b

# --- Source repo (scripts + manifests are pulled onto the VPS from here) ---
REPO_URL=https://github.com/crowdy/conoha-cli-app-samples
REPO_BRANCH=main
